# Fragment NetHunter pour GKI android16-6.12 (Pixel 7a "lynx" / Tensor G2 gs201)
#
# Base : gki_defconfig.
# Applique via :  make LLVM=1 O=out ARCH=arm64 gki_defconfig nethunter.config
#   (la cible <name>.config utilise scripts/kconfig/merge_config.sh -m)
#
# Principe GKI : on n'altere PAS le coeur du noyau GKI (frozen / ABI stable).
# On ajoute des pilotes en tant que MODULES CHARGEABLES (.ko), qui est le point
# d'extension autorise par Google (vendor modules, charges via modules.load).
#
# mac80211 / cfg80211 ne sont PAS dans gki_defconfig (sur le device ils sont
# fournis par les modules vendor du build LineageOS). On les reconstruit ici en
# =m pour fournir une stack wireless complete et reproductible, et pour que les
# pilotes USB externes (rt2800usb, ath9k_htc, ...) aient leurs dependances.

# --- Rust : desactive (toolchain Rust/bindgen non necessaire pour ces modules) ---
CONFIG_RUST=n
CONFIG_ANDROID_BINDER_IPC_RUST=n

# --- BTF : ACTIVE (OBLIGATOIRE pour GKI).
# Dans kernel/common/include/linux/module.h, struct module contient
# btf_data et btf_data_size sous CONFIG_DEBUG_INFO_BTF_MODULES.
# Si désactivé, la taille et le layout de struct module changent, ce qui
# modifie le CRC de module_layout (disagrees about version of symbol module_layout).
# L'erreur de build de resolve_btfids est évitée en passant les flags
# HOSTCFLAGS appropriés dans build.sh. ---
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y

# --- LTO thin (OBLIGATOIRE pour GKI) ---
# Le noyau GKI Google (android14-6.1) est compile AVEC LTO thin
# (CONFIG_LTO_CLANG_THIN=y) via le build system officiel (build/build.sh).
# gki_defconfig n'active PAS LTO a lui seul. Un module compile SANS LTO ne
# charge pas sur un noyau LTO : le module loader le rejette avec
# "invalid module format" (ENOEXEC). On force donc LTO thin ici pour que
# les .ko produits (in-tree et out-of-tree) matchent le noyau du device.
CONFIG_LTO_CLANG_THIN=y


# --- Stack wireless (cfg80211 + mac80211) en modules ---
# Monitor mode + injection de paquets : natif dans mac80211 mainline 6.12,
# AUCUN patch necessaire (les patchs "packet injection" NetHunter 3.x/4.x/5.4
# ont ete upstreames depuis le noyau 5.7).
# NOTE: CONFIG_CFG80211_WEXT=n pour matcher le vendor cfg80211.ko du Pixel 7a.
# NOTE: CONFIG_NL80211_TESTMODE=y pour aligner struct cfg80211_ops avec le vendor.
CONFIG_CFG80211=m
CONFIG_CFG80211_WEXT=n
CONFIG_NL80211_TESTMODE=y
CONFIG_MAC80211=m
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_RC_DEFAULT_MINSTREL=y
CONFIG_MAC80211_MESH=y

# --- Ralink/MediaTek RT2800USB (RT5370 / RT3070 — Panda PAU0D / PAU07) ---
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_UNKNOWN=y

# --- Realtek rtl8xxxu (RTL8188AU / RTL8192CU / RTL8192EU) ---
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y

# --- Atheros ath9k_htc (AR9271) ---
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH_COMMON=m
CONFIG_ATH9K_HTC=m

# --- Bluetooth USB HCI (dongle BT USB, injection) ---
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_MTK=y

# --- USB gadget RNDIS (tethering Windows) + gadgetfs (HID legacy) ---
# f_hid (USB_CONFIGFS_F_HID=y) et functionfs (USB_CONFIGFS_F_FS=y) sont DEJA
# actives dans gki_defconfig : attaques USB HID disponibles sans ajout.
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_GADGETFS=y
