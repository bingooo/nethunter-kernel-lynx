# Fragment NetHunter — Pixel 7a (lynx) — base : device-config.txt
#
# La base de config est MAINTENANT la config EXACTE du device (configs/device-config.txt,
# = zcat /proc/config.gz du Pixel 7a sous 6.1.157). On n'ajoute donc ICI que :
#   1. les modules wireless/BT manquants (absents de la config device) ;
#   2. la desactivation des LED rt2x00/mac80211 (le device n'exporte pas
#      led_classdev_suspend/resume ni __ieee80211_create_tpt_led_trigger -> err -2).
#
# On NE force PLUS LTO (la config device est NON-LTO : CONFIG_LTO_CLANG_THIN not set)
# ni BTF (deja =y dans la config device). On suit le device pour que les CRC du
# coeur (sk_buff, dev_*, ...) matchent nativement. Les CRC wireless (mac80211/
# cfg80211, qui sont des modules GKI buildes a part par Google) sont realignes
# APRES le build par patch_crcs.py avec configs/phone_wireless.symvers.

# --- Rust : non necessaire pour ces modules ---
CONFIG_RUST=n

# --- Stack wireless en modules (requise pour compiler les drivers USB) ---
CONFIG_CFG80211=m
CONFIG_MAC80211=m

# --- Ralink/MediaTek RT2800USB (RT3070 — Alfa AWUS036NH) ---
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_UNKNOWN=y

# --- Atheros ath9k_htc (AR9271) : RETIRE de ce build ---
# ath9k fait 'select MAC80211_LEDS if LEDS_CLASS=y' -> reactive l'inline
# ieee80211_create_tpt_led_trigger -> rt2x00lib refere __ieee80211_create_tpt_led_trigger
# (absent du device). On ne build PAS ath9k ici (AR9271 pas encore en main) ;
# a rajouter plus tard en gerant son select LED. Priorite : RT3070 (rt2x00).
# CONFIG_ATH9K_HTC is not set

# --- Realtek rtl8xxxu ---
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y

# --- Bluetooth USB HCI ---
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_RTL=y

# --- LED OFF : symboles absents du device -> ne pas les referencer ---
# rt2x00lib refere __ieee80211_create_tpt_led_trigger + led_classdev_suspend/
# resume (err -2 sur le device). RT2X00_LIB_LEDS est SANS PROMPT (auto-active
# si LEDS_CLASS=y) -> on le coupe a la racine en desactivant NEW_LEDS.
# CONFIG_NEW_LEDS is not set
# CONFIG_LEDS_CLASS is not set
# CONFIG_RT2X00_LIB_LEDS is not set
# CONFIG_MAC80211_LEDS is not set

# --- Neutraliser l'outillage ABI/certs GKI (fichiers absents d'un checkout nu) ---
# TRIM_UNUSED_KSYMS exige android/abi_symbollist.raw (ERROR whitelist not found).
# On le coupe : on veut de toute facon TOUS les symboles exportes. Ne change pas
# les CRC (le trim change quels symboles sont exportes, pas leur hash).
# CONFIG_TRIM_UNUSED_KSYMS is not set
CONFIG_UNUSED_KSYMS_WHITELIST=""
# Cles/certs : chemins Android absents -> build genere une cle jetable / vide.
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_MODULE_SIG_KEY=""
